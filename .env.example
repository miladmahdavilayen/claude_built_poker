# Copy to .env and fill in before running `docker compose up`.

# Required: sign/verify JWT access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Postgres credentials used by both the postgres container and the server's
# DATABASE_URL (docker-compose.yml assembles the URL from these for you).
POSTGRES_USER=pokerclause
POSTGRES_PASSWORD=pokerclause
POSTGRES_DB=pokerclause

# The origin the BROWSER will load the client from — must match exactly
# (scheme + host + port) or the server will reject requests via CORS and
# refuse the refresh-token cookie.
CORS_ORIGIN=http://localhost:5173

# Baked into the client's JS bundle at build time. Must be reachable from
# the player's browser (not just from inside the Docker network) — e.g.
# your server's public IP/domain and port when deploying beyond localhost.
VITE_API_URL=http://localhost:4000

# Set to "false" to skip auto-creating the two default public tables on boot.
SEED_DEFAULT_TABLES=true

# The owner/admin account, auto-created (or promoted, if it already exists)
# on every boot — see ensureAdminAccount in apps/server/src/index.ts.
# Defaults to admin@pokerclause.local / admin12345 if left blank, which is
# published in this repo's own README — change these before exposing a
# deployment to anyone but yourself.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: "Sign in with Google". Guests and email/password accounts work
# fully without this — leave both blank to skip it entirely (the button
# just won't render). To enable it, create an OAuth Client ID (type "Web
# application") at https://console.cloud.google.com/apis/credentials, add
# this app's origin(s) (e.g. http://localhost:5173, and your real domain in
# production) to "Authorized JavaScript origins", and set BOTH of these to
# that same Client ID — see README.md for the full walkthrough.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
